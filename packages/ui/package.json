{
  "name": "@sebastian-websites/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "description": "The shared frame and editorial primitives of all sites: header, page ending, stories, and blocks.",
  "exports": {
    ".": "./src/index.ts",
    "./brand-consulting.css": "./src/brand-consulting.css.ts",
    "./brand-software.css": "./src/brand-software.css.ts",
    "./frame-copy": "./src/frame/frameCopy.ts",
    "./responsive": "./src/responsive.ts",
    "./error-copy": "./src/frame/errorCopy.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "oxlint -c ../../oxlint.config.ts src && eslint src --config ../../eslint.config.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "pnpm -w exec vitest run --project ui",
    "agent:check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@palamedes/core": "catalog:",
    "@sebastian-websites/legal": "workspace:*",
    "@sebastian-websites/tokens": "workspace:*",
    "@sebastian-websites/web-core": "workspace:*",
    "@vanilla-extract/css": "catalog:",
    "lucide-react": "catalog:",
    "@palamedes/runtime": "catalog:",
    "ardo": "6.9.0"
  },
  "devDependencies": {
    "@sebastian-websites/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "happy-dom": "catalog:",
    "jiti": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
