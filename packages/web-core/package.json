{
  "name": "@sebastian-websites/web-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "description": "Variants, brand bar, and shared web fundamentals for all sites.",
  "exports": {
    ".": "./src/index.ts",
    "./bunny-images": "./src/bunny-images.d.ts",
    "./vite": "./src/bunnyImagesPlugin.ts"
  },
  "scripts": {
    "typecheck": "tsc",
    "lint": "oxlint -c ../../oxlint.config.ts src && eslint src --config ../../eslint.config.ts",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "pnpm -w exec vitest run --project web-core",
    "agent:check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@palamedes/core": "catalog:"
  },
  "devDependencies": {
    "@sebastian-websites/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "image-size": "^2.0.4",
    "jiti": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "ardo": "6.8.0"
  }
}
