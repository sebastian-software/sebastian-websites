{
  "name": "sebastian-websites",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write . && pnpm -r --if-present format",
    "format:root": "prettier --check README.md GLOSSARY.md docs package.json pnpm-workspace.yaml prettier.config.mjs",
    "check:boundaries": "pnpm --filter @sebastian-websites/config --fail-if-no-match check:boundaries",
    "agent:check": "pnpm format:root && pnpm check:boundaries && pnpm -r --if-present agent:check"
  },
  "devDependencies": {
    "@sebastian-websites/config": "workspace:*",
    "prettier": "catalog:"
  }
}
