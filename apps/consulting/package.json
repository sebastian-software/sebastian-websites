{
  "name": "@sebastian-websites/consulting",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "description": "The Sebastian Consulting site.",
  "scripts": {
    "dev": "react-router dev",
    "build": "pnpm build:de && pnpm build:en",
    "build:de": "SITE_VARIANT=consulting-de pnpm build:variant",
    "build:en": "SITE_VARIANT=consulting-en pnpm build:variant",
    "build:variant": "rm -rf public/pdfs && pnpm generate:pdf && react-router build && pnpm verify:build",
    "generate:pdf": "tsx scripts/generatePdfs.ts",
    "verify:build": "tsx scripts/verifyBuild.ts",
    "typecheck": "react-router typegen && tsc",
    "lint": "oxlint -c ../../oxlint.config.ts app scripts && eslint app scripts --config ../../eslint.config.ts",
    "format": "prettier --write app scripts",
    "format:check": "prettier --check app scripts",
    "test": "vitest run",
    "palamedes:extract": "pmds extract",
    "check:translations": "pmds audit --fail-on warning",
    "agent:check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:translations && pnpm test"
  },
  "dependencies": {
    "@palamedes/core": "catalog:",
    "@palamedes/react": "catalog:",
    "@palamedes/runtime": "catalog:",
    "@sebastian-websites/legal": "workspace:*",
    "@sebastian-websites/ui": "workspace:*",
    "@sebastian-websites/web-core": "workspace:*",
    "@vanilla-extract/css": "catalog:",
    "isbot": "^5",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@palamedes/cli": "catalog:",
    "@palamedes/vite-plugin": "catalog:",
    "@react-router/dev": "catalog:",
    "@sebastian-websites/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "oxlint": "catalog:",
    "pdfjs-dist": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
