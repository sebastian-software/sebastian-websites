{
  "name": "@sebastian-websites/consulting",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "description": "The Sebastian Consulting site.",
  "scripts": {
    "dev": "node scripts/build.ts --dev",
    "build": "node scripts/build.ts",
    "build:de": "node scripts/build.ts consulting-de",
    "build:en": "node scripts/build.ts consulting-en",
    "generate:pdf": "tsx scripts/generatePdfs.ts",
    "verify:build": "tsx scripts/verifyBuild.ts",
    "typecheck": "tsc",
    "lint": "oxlint -c ../../oxlint.config.ts app scripts && eslint app scripts --config ../../eslint.config.ts",
    "format": "prettier --write app scripts ardo.config.ts tsconfig.json",
    "format:check": "prettier --check app scripts ardo.config.ts tsconfig.json",
    "test": "pnpm -w exec vitest run --project consulting",
    "palamedes:extract": "pmds extract",
    "check:translations": "pmds audit --fail-on warning",
    "agent:check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm lint:messages && pnpm check:translations && pnpm test",
    "lint:messages": "pmds lint --fail-on warning"
  },
  "dependencies": {
    "@palamedes/core": "catalog:",
    "@palamedes/react": "catalog:",
    "@palamedes/runtime": "catalog:",
    "@sebastian-websites/legal": "workspace:*",
    "@sebastian-websites/site": "workspace:*",
    "@sebastian-websites/ui": "workspace:*",
    "@sebastian-websites/web-core": "workspace:*",
    "@vanilla-extract/css": "catalog:",
    "ardo": "6.7.0"
  },
  "devDependencies": {
    "@palamedes/cli": "catalog:",
    "@sebastian-websites/config": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "oxlint": "catalog:",
    "pdfjs-dist": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
