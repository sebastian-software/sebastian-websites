{
  "name": "@sebastian-websites/software",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "description": "The Sebastian Software site.",
  "scripts": {
    "dev": "node scripts/build.ts --dev",
    "build": "node scripts/build.ts",
    "build:de": "node scripts/build.ts software-de",
    "build:en": "node scripts/build.ts software-en",
    "typecheck": "tsc",
    "lint": "oxlint -c ../../oxlint.config.ts app scripts && eslint app scripts --config eslint.config.ts",
    "format": "prettier --write app scripts vite.config.ts eslint.config.ts",
    "format:check": "prettier --check app scripts vite.config.ts eslint.config.ts",
    "palamedes:extract": "pmds extract",
    "check:translations": "pmds audit --fail-on warning",
    "agent:check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm lint:messages && pnpm check:translations && pnpm test",
    "test": "node --test \"scripts/**/*.test.ts\" \"app/**/*.test.ts\"",
    "lint:messages": "pmds lint --fail-on warning",
    "check:browser": "node scripts/check-browser.ts",
    "check:browser:fixtures": "node scripts/check-browser.ts --fixtures",
    "check:fixtures": "node scripts/check-fixtures.ts"
  },
  "dependencies": {
    "@palamedes/core": "catalog:",
    "@palamedes/react": "catalog:",
    "@palamedes/runtime": "catalog:",
    "@sebastian-websites/content": "workspace:*",
    "@sebastian-websites/legal": "workspace:*",
    "@sebastian-websites/ui": "workspace:*",
    "@sebastian-websites/web-core": "workspace:*",
    "@vanilla-extract/css": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "ardo": "6.4.1"
  },
  "devDependencies": {
    "@palamedes/cli": "catalog:",
    "@palamedes/vite-plugin": "catalog:",
    "@sebastian-websites/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
    "@palamedes/transform": "^2.0.0",
    "image-size": "^2.0.4",
    "playwright": "catalog:",
    "yaml": "^2.9.1"
  }
}
