{
  "name": "@sebastian-websites/opensource",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "description": "The Open Source site of Sebastian Software.",
  "scripts": {
    "dev": "node scripts/build.ts --dev",
    "build": "node scripts/build.ts",
    "build:de": "node scripts/build.ts opensource-de",
    "build:en": "node scripts/build.ts opensource-en",
    "typecheck": "tsc",
    "lint": "oxlint -c ../../oxlint.config.ts app && eslint app --config ../../eslint.config.ts",
    "format": "prettier --write app scripts ardo.config.ts vite.config.ts tsconfig.json",
    "format:check": "prettier --check app scripts ardo.config.ts vite.config.ts tsconfig.json",
    "palamedes:extract": "pmds extract",
    "check:translations": "pmds audit --fail-on warning",
    "agent:check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm lint:messages && pnpm check:translations && pnpm test",
    "test": "vitest run",
    "lint:messages": "pmds lint --fail-on warning"
  },
  "dependencies": {
    "@palamedes/core": "catalog:",
    "@palamedes/react": "catalog:",
    "@palamedes/runtime": "catalog:",
    "@sebastian-websites/content": "workspace:*",
    "@sebastian-websites/legal": "workspace:*",
    "@sebastian-websites/ui": "workspace:*",
    "@sebastian-websites/web-core": "workspace:*",
    "@vanilla-extract/css": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "@sebastian-websites/site": "workspace:*",
    "ardo": "6.6.0"
  },
  "devDependencies": {
    "@palamedes/cli": "catalog:",
    "@palamedes/vite-plugin": "catalog:",
    "@sebastian-websites/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
