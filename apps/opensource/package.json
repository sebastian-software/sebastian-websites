{
  "name": "@sebastian-websites/opensource",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "description": "The Open Source site of Sebastian Software.",
  "scripts": {
    "dev": "react-router dev",
    "build": "pnpm build:de && pnpm build:en",
    "build:de": "SITE_VARIANT=opensource-de react-router build",
    "build:en": "SITE_VARIANT=opensource-en react-router build",
    "typecheck": "react-router typegen && tsc",
    "lint": "oxlint -c ../../oxlint.config.ts app && eslint app --config ../../eslint.config.ts",
    "format": "prettier --write app",
    "format:check": "prettier --check app",
    "palamedes:extract": "pmds extract",
    "check:translations": "pmds audit --fail-on warning",
    "agent:check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm check:translations && pnpm test",
    "test": "vitest run"
  },
  "dependencies": {
    "@palamedes/core": "catalog:",
    "@palamedes/react": "catalog:",
    "@palamedes/runtime": "catalog:",
    "@sebastian-websites/content": "workspace:*",
    "@sebastian-websites/legal": "workspace:*",
    "@sebastian-websites/ui": "workspace:*",
    "@sebastian-websites/web-core": "workspace:*",
    "@vanilla-extract/css": "catalog:",
    "isbot": "^5",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-router": "catalog:"
  },
  "devDependencies": {
    "@palamedes/cli": "catalog:",
    "@palamedes/vite-plugin": "catalog:",
    "@react-router/dev": "catalog:",
    "@sebastian-websites/config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vanilla-extract/vite-plugin": "catalog:",
    "eslint": "catalog:",
    "jiti": "catalog:",
    "oxlint": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
